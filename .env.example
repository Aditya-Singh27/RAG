# Names only. Copy to .env and fill in; .env is git-ignored.
GEMINI_API_KEY=

# ---- Problem 1 (RAG) ----
EMBED_PROVIDER=gemini            # gemini | hash (hash = offline test embedder, NOT for reported results)
EMBED_MODEL=                     # e.g. the Gemini embedding model id; verify with scripts/check_providers.py
EMBED_DIM=768
RAG_GEN_PROVIDER=gemini          # gemini | openai_compat
RAG_GEN_MODEL=
LANCEDB_URI=./lancedb_data
CHUNK_SIZE=800
CHUNK_OVERLAP=100
RETRIEVAL_K=5
MIN_SCORE=0.60                   # cosine-similarity floor for the no-context branch (calibrated against out-of-domain queries)

# ---- Problem 2 (judge) ----
JUDGE_PROVIDER=gemini
JUDGE_MODEL=
GENERATOR_PROVIDER=openai_compat  # must be a different model family from the judge
GENERATOR_MODEL=
GENERATOR_BASE_URL=http://localhost:11434/v1   # e.g. Ollama
GENERATOR_API_KEY=ollama
LLM_LOG_PATH=./logs/llm_calls.jsonl
